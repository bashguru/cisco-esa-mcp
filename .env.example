# Copy to .env and edit.  cp .env.example .env

# ---- Where your source documents live (mounted read-only at /data/input) ----
INPUT_DIR=./docs_input

# ---- Database ---------------------------------------------------------------
POSTGRES_USER=cisco
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ciscodocs
DB_PORT=5432
# DATABASE_URL is set for you by docker-compose from the values above.

# ---- MCP server -------------------------------------------------------------
MCP_SERVER_NAME=cisco-docs
MCP_PORT=8000
MCP_PATH=/mcp

# ---- Authentication ---------------------------------------------------------
# local      = no auth (localhost only). Use this for a private local install.
# cloudflare = require a Cloudflare Access service-token JWT and log remote use.
AUTH_MODE=local
# Only needed when AUTH_MODE=cloudflare:
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=your-access-application-audience-tag
ALLOW_ANY_TOKEN=false
USERS_FILE=/app/config/users.yaml

# ---- Cloudflare Tunnel (only used with --profile tunnel) --------------------
TUNNEL_TOKEN=

# ---- Embeddings (default: BGE-M3, 1024-dim, CPU) ----------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH=16

# ---- Reranker (the accuracy multiplier) -------------------------------------
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu

# ---- Figure captioning / OCR (optional, needs a vision model) ---------------
# Turn off if you have no vision model; ingestion still keeps native captions.
ENABLE_VLM_CAPTIONS=true
VLM_BACKEND=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
VLM_MODEL=qwen2.5vl:7b
VLM_TIMEOUT=120
ENABLE_OCR=true
IMAGES_SCALE=2.0

# ---- Retrieval tuning -------------------------------------------------------
RETRIEVE_BM25_K=40
RETRIEVE_VECTOR_K=40
RRF_K=60
RRF_TEXT_WEIGHT=1.0
RRF_VECTOR_WEIGHT=1.0
RERANK_CANDIDATES=30
RESULT_TOP_K=8
CHUNK_MAX_TOKENS=512

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
AUDIT_LOG_FILE=/data/logs/audit.log
